{% if inventory_hostname == 'vm1' %}
upstream app_backend {
    server 172.20.0.20:80;
    server 172.20.0.30:80;
}

server {
    listen 80;
    listen [::]:80;

    server_name public.vm1.local;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name public.vm1.local;

    ssl_certificate /etc/nginx/ssl/assessment.crt;
    ssl_certificate_key /etc/nginx/ssl/assessment.key;

    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/assessment;
    index index.html;

    ssi on;

    location /vm2 {
        proxy_pass http://172.20.0.20/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /vm3 {
        proxy_pass http://172.20.0.30/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /app {
        proxy_pass http://app_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
{% else %}
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    root /var/www/assessment;
    index index.html;

    ssi on;

    location / {
        try_files $uri $uri/ =404;
    }
}
{% endif %}
